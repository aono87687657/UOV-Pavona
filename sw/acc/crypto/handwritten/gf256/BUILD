load("//rules:acc.bzl", "acc_library", "acc_binary","acc_sim_test")
package(default_visibility = ["//visibility:public"])

# Create a library with the GF256 multiplication implementation
acc_library(
    name = "gf256_mul",
    srcs = ["gf256_mul.s"],
)

# SW GF(256) multiply-accumulate helpers (gf256_macc_sw, gf256_scalar_inv_sw).
# Cross-cutting: linked by the sw/bngfonly keygen + sign kernels. The scalar
# inverse calls gf256mul_vxv_square, so consumers must also link that lib
# (acc_library carries no deps).
acc_library(
    name = "gf256_sw_helpers",
    srcs = ["gf256_sw_helpers.s"],
)

# gf256_macc_dualvec_sw on every scalar 0..255 against a reference GF(2^8) multiply.
acc_sim_test(
    name = "gf256_macc_dualvec_sw_test",
    srcs = ["gf256_macc_dualvec_sw_test.s"],
    dexp = "gf256_macc_dualvec_sw_test.dexp",
    pqc = True,
    deps = [":gf256_sw_helpers", ":gf256mul_vxv_square"],
)


acc_sim_test(
    name="gf256_mul_test",
    srcs=["gf256_mul_test.s"],
    deps=[":gf256_mul"],
    exp="gf256_mul_test.exp",
)


acc_sim_test(
    name="gf256_extmul_test",
    srcs=["gf256_extmul_test.s"],
    exp="gf256_extmul_test.exp",
    pqc=True,
)

# PQC-optimized GF256 multiply using bn.mulv.l
acc_library(
    name = "gf256_mul_pqc",
    srcs = ["gf256_mul_pqc.s"],
)

acc_sim_test(
    name="gf256_mul_pqc_test",
    srcs=["gf256_mul_pqc_test.s"],
    deps=[":gf256_mul_pqc"],
    exp="gf256_mul_pqc_test.exp",
    pqc=True,
)

# Randomized test binaries (inputs injected by Python test script)
acc_binary(
    name = "gf256_mul_rand_test",
    srcs = ["gf256_mul_rand_test.s"],
    deps = [":gf256_mul"],
)

acc_binary(
    name = "gf256_mul_pqc_rand_test",
    srcs = ["gf256_mul_pqc_rand_test.s"],
    deps = [":gf256_mul_pqc"],
)

acc_library(
    name = "gf256mul_vxv_square",
    srcs = ["gf256mul_vxv_square.s"],
)

acc_binary(
    name = "gf256mul_vxv_square_test",
    srcs = ["gf256mul_vxv_square_test.s"],
    deps = [":gf256mul_vxv_square"],
)

# Parallel 32-byte GF(256) vec-vec multiply (Russian-peasant)
acc_library(
    name = "gf256mul_vxv",
    srcs = ["gf256mul_vxv.s"],
)

acc_binary(
    name = "gf256mul_vxv_test",
    srcs = ["gf256mul_vxv_test.s"],
    deps = [":gf256mul_vxv"],
)

# bn.gfmul ACCH accumulator-select (.acch) test.
# Expected values generated by test_scripts/gf256_acch_expectgen.py.
acc_sim_test(
    name = "gf256_acch_test",
    srcs = ["gf256_acch_test.s"],
    exp = "gf256_acch_test.exp",
    pqc = True,
)

# Cycle-measurement isolation drivers (one SW GF256 vector*scalar op).
acc_binary(
    name = "gf256_mul_op_test",
    srcs = ["gf256_mul_op_test.s"],
    deps = [":gf256_mul"],
)
acc_binary(
    name = "gf256_mul_pqc_op_test",
    srcs = ["gf256_mul_pqc_op_test.s"],
    deps = [":gf256_mul_pqc"],
)

# Cycle-measurement isolation driver (one HW GF256 bn.gfmul.8).
acc_binary(
    name = "gf256_gfmul_op_test",
    srcs = ["gf256_gfmul_op_test.s"],
)

# Setup-only baselines (isolate the op cost by subtraction).
acc_binary(name = "gf256_setup_hw_test", srcs = ["gf256_setup_hw_test.s"])
acc_binary(name = "gf256_setup_sw_test", srcs = ["gf256_setup_sw_test.s"])
