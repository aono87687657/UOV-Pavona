name: "lowrisc:ip:acc:0.1"
description: "Asymmetric Cryptography Coprocessor (ACC)"

filesets:
  files_rtl_core:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:util
      - lowrisc:prim:lfsr
      - lowrisc:prim:xoshiro256pp
      - lowrisc:prim:cipher_pkg
      - lowrisc:prim:mubi
      - lowrisc:prim:crc32
      - lowrisc:prim:sparse_fsm
      - lowrisc:prim:onehot
      - lowrisc:prim:blanker
      - lowrisc:ip:keymgr_pkg
      - lowrisc:ip:edn_pkg
      - lowrisc:ip:kmac_pkg
      - lowrisc:ip:acc_pkg
      - lowrisc:prim:onehot_check
      - aes_bignum ? (lowrisc:ip:aes:1.0)
    files:
      - rtl/acc_controller.sv
      - rtl/acc_decoder.sv
      - rtl/acc_predecode.sv
      - rtl/acc_instruction_fetch.sv
      - rtl/acc_rf_base.sv
      - rtl/acc_rf_bignum.sv
      - rtl/acc_rf_base_ff.sv
      - rtl/acc_rf_bignum_ff.sv
      - rtl/acc_rf_base_fpga.sv
      - rtl/acc_rf_bignum_fpga.sv
      - rtl/acc_lsu.sv
      - rtl/acc_alu_base.sv
      - rtl/acc_digest_mux.sv
      - rtl/acc_alu_bignum.sv
      - rtl/bn_vec_core/unified_mul.sv
      - rtl/bn_vec_core/acc_bignum_mul.sv
      - rtl/bn_vec_core/buffer_bit.sv
      - gfmacc_bignum ? (rtl/gfmacc.sv)
      - rtl/acc_mac_bignum.sv
      - aes_bignum ? (rtl/acc_aes_bignum.sv)
      - aes_bignum ? (rtl/aes/aes_round_keyexpand.sv)
      - rtl/acc_loop_controller.sv
      - rtl/acc_stack.sv
      - rtl/acc_rnd.sv
      - rtl/acc_start_stop_control.sv
      - rtl/acc_core.sv
    file_type: systemVerilogSource

  files_rtl_top:
    depend:
      - lowrisc:ip:tlul
      - lowrisc:prim:all
      - lowrisc:prim:assert
      - lowrisc:prim:util
      - lowrisc:prim:ram_1p_scr
      - lowrisc:prim:lc_sync
      - lowrisc:ip:edn_pkg
      - lowrisc:prim:edn_req
      - lowrisc:ip:acc_pkg
      - lowrisc:ip:otp_ctrl_pkg
    files:
      - rtl/acc_reg_top.sv
      - rtl/acc_scramble_ctrl.sv
      - rtl/acc.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/acc.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/acc.waiver
    file_type: waiver

  files_sta_vivado:
    files:
      - sta/vivado_synth.tcl:
          copyto: vivado_synth.tcl
          is_include_file: true
      - sta/vivado_timing.tcl:
          copyto: vivado_timing.tcl
          is_include_file: true

  files_sta_genus:
    files:
      - sta/genus_synth.tcl:
          copyto: genus_synth.tcl
          is_include_file: true
      - sta/genus_timing.tcl:
          copyto: genus_timing.tcl
          is_include_file: true


parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine
  SYNTHESIS_MEMORY_BLACK_BOXING:
    datatype: bool
    default: false
    paramtype: vlogdefine
  AccPQCEn:
    datatype: int
    description: Enable the PQC vector ISA extension in the ACC
    default: 0
    paramtype: vlogparam
  GFMACC_BIGNUM:
    datatype: bool
    paramtype: vlogdefine
  MOD_REG_POLY:
    datatype: bool
    paramtype: vlogdefine
  AES_BIGNUM:
    datatype: bool
    paramtype: vlogdefine

targets:
  default: &default_target
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - tool_ascentlint ? (files_ascentlint_waiver)
      - files_rtl_core
      - files_rtl_top
    toplevel: acc
    parameters:
      - gfmacc_bignum ? (GFMACC_BIGNUM=true)
      - mod_reg_poly ? (MOD_REG_POLY=true)
      - aes_bignum ? (AES_BIGNUM=true)

  lint:
    <<: *default_target
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
      - GFMACC_BIGNUM=true
      - MOD_REG_POLY=true
      - AES_BIGNUM=true
    tools:
      verilator:
        mode: lint-only

  lint-core:
    filesets:
      - files_rtl_core
    toplevel: acc_core
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
      - GFMACC_BIGNUM=true
      - MOD_REG_POLY=true
      - AES_BIGNUM=true
    tools:
      verilator:
        mode: lint-only

  syn:
    <<: *default_target
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    default_tool: icarus
    parameters:
      - SYNTHESIS=true
      - gfmacc_bignum ? (GFMACC_BIGNUM=true)
      - mod_reg_poly ? (MOD_REG_POLY=true)
      - aes_bignum ? (AES_BIGNUM=true)

  sta:
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - tool_ascentlint ? (files_ascentlint_waiver)
      - files_rtl_core
      - files_rtl_top
    toplevel: acc

    default_tool: vivado
    parameters:
      - SYNTHESIS=true
#      - SYNTHESIS_MEMORY_BLACK_BOXING=true
      - "pqc ? (AccPQCEn=1)"
      - "!pqc ? (AccPQCEn=0)"
      - gfmacc_bignum ? (GFMACC_BIGNUM=true)
      - mod_reg_poly ? (MOD_REG_POLY=true)
      - aes_bignum ? (AES_BIGNUM=true)
    filesets_append:
      - tool_vivado ? (files_sta_vivado)
      - tool_genus  ? (files_sta_genus)
    tools:
      vivado:
        part: "xc7k160tfbg676-1" # CW310 with K410T
      genus:
        genus_script: "genus.tcl"
        jobs: "8"

